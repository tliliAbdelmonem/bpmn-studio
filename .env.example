# Copy to .env (git-ignored). Read by the API (apps/api) and by docker compose.

# --- API ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://bpmn:bpmn@localhost:5432/bpmn_studio
CAMUNDA_BASE_URL=http://localhost:8080/v2
# Only needed if the web app is served without the dev proxy
# CORS_ORIGIN=http://localhost:4200
MAX_BPMN_SIZE_BYTES=5242880

# --- docker compose ---
POSTGRES_USER=bpmn
POSTGRES_PASSWORD=bpmn
POSTGRES_DB=bpmn_studio
POSTGRES_PORT=5432
CAMUNDA_VERSION=8.10.4
